---
import "../styles/global.css";

const { id } = Astro.params;
if (typeof window !== "undefined") {
    if (id) {
        localStorage.setItem('centroId', id);
    }
}

let centro = null;
let instalaciones = [];
let usuario: { id: number } | null | undefined = null;

try {
    // Obtener información del centro
    const responseCentro = await fetch(`http://centroscivicos.local/api/centros/${id}`);
    if (!responseCentro.ok) throw new Error('Centro no encontrado');
    centro = await responseCentro.json();

    // Obtener instalaciones
    const responseInstalaciones = await fetch(`http://centroscivicos.local/api/centros/${id}/instalaciones`);
    if (!responseInstalaciones.ok) throw new Error('Instalaciones no encontradas');
    instalaciones = await responseInstalaciones.json();

} catch (error) {
    console.error('Error al cargar la información:', error);
}
---
<script defer>
document.addEventListener("DOMContentLoaded", async function () {
    if (typeof window !== "undefined"){
        const token = localStorage.getItem('authToken');
        const responseUser = await fetch(`http://centroscivicos.local/api/user`, {
            method: 'GET',  // Tipo de solicitud
            headers: {
            'Content-Type': 'application/json',  // Indicamos el tipo de contenido
            'Authorization': `Bearer ${token}`   // Pasamos el token en el encabezado Authorization
            }
        });
        if (!responseUser.ok) throw new Error('Usuario no encontrado');
        usuario = await responseUser.json();
        console.log(usuario);
    }
    const form = document.getElementById("registroForm");

    // Verificamos si el formulario existe antes de acceder a él
    if (form) {
        form.addEventListener("submit", async function (event) {
            event.preventDefault();

            const token = localStorage.getItem('authToken');
            const solicitante = document.getElementById("solicitante").value;
            const telefono = document.getElementById("telefono").value;
            const email = document.getElementById("email").value;
            const instalacion = document.getElementById("instalacion").value;
            const id_usuario = usuario[0].id;
            const fecha_inicio = document.getElementById("fecha_inicio").value;
            const fecha_fin = document.getElementById("fecha_fin").value;
            const estado = document.getElementById("estado").value;

            console.log(solicitante, telefono, email, instalacion, id_usuario, fecha_inicio, fecha_fin, estado);

            try {
                const response = await fetch("http://centroscivicos.local/api/reservas/", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        solicitante: solicitante,
                        telefono: telefono,
                        email: email,
                        instalacion_id: instalacion,
                        fecha_inicio: fecha_inicio,
                        fecha_fin: fecha_fin,
                        estado: estado
                    })
                });

                if (response.ok) {
                    const data = await response.json();
                    alert("La reserva ha sido creda con exito");
                    window.location.href = "/perfil";
                } else {
                    alert("Error al registrar la reserva");
                }
            } catch (error) {
                console.error("Error en la petición:", error);
                alert("Hubo un problema con la conexión");
            }
        });
    } else {
        console.error("Error: No se encontró el formulario en el DOM.");
    }
});
</script>

<!-- Formulario en el mismo archivo -->
<div class="flex justify-center items-center bg-gray-100">
    <div class="bg-white shadow-lg rounded-2xl p-8 w-full max-w-md">
        <h1 class="text-2xl font-bold text-center text-gray-700 mb-6">Reservar en {centro.nombre}</h1>
      
        <form id="registroForm" class="space-y-4">
            <div>
                <label for="solicitante" class="block text-sm font-medium text-gray-600">Nombre del Solicitante</label>
                <input type="text" id="solicitante" placeholder="Solicitante" required
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div>
                <label for="telefono" class="block text-sm font-medium text-gray-600">Telefono</label>
                <input type="text" id="telefono" placeholder="telefono" required
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div>
                <label for="email" class="block text-sm font-medium text-gray-600">E-mail</label>
                <input type="email" id="email" placeholder="e-mail" required
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div>
                <label for="instalacion" class="block text-sm font-medium text-gray-600">Instalacion</label>
                <select id="instalacion" required
                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" >
                    {instalaciones.length > 0 ? (
                        instalaciones.map((instalacion: {id: number, nombre: string}) => (
                        <option value={instalacion.id}>{instalacion.nombre}</option>
                        ))
                    ) : (
                        <p class="text-gray-500 mt-2">No hay instalaciones registradas.</p>
                    )}
                </select>
            </div>
            <div>
                <label for="fecha_inicio" class="block text-sm font-medium text-gray-600">Fecha de Inicio</label>
                <input type="date" id="fecha_inicio" required
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <div>
                <label for="fecha_fin" class="block text-sm font-medium text-gray-600">Fecha de Final</label>
                <input type="date" id="fecha_fin" required
                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>
            <input type="hidden" id="estado" value="Pendiente" />
            <button type="submit"
            class="w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 rounded-lg transition duration-200">
            Registrar
            </button>
        </form>
    </div>
  </div>